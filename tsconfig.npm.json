{
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/lib/**/*",
    "src/types/**/*",
    "src/hooks/useVideoMetadata.ts"
  ],
  "exclude": [
    "src/components/**/*",
    "src/assets/**/*",
    "**/*.test.*",
    "**/*.spec.*",
    "dist",
    "node_modules"
  ]
}